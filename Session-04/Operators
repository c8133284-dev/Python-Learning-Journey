# Operators in Python

# Logical Operators
a = int(input("Enter first number: "))
b = int(input("Enter second number: "))
print("both are greater than 10:", a > 10 and b > 10)
print("at least one is less than 5:", a < 5 or b < 5)
print("first number is not greater than the second:", not (a > b))

# Conditional Statement
age = int(input("Enter your age: "))
if age >= 18:
    print("they are adult.")
else:
    print("they are minor") 

# Membership Operators     
string = "I love python"
print("is 'a' in string:", 'a' in string)
print("is 'python' not in string:", 'python' not in string)

# Bitwise Operators
a = 20
b = 10
print(a & b)
print(a | b)
print(a ^ b)
print(~a)
print(a << 2)
print(b >> 1)
